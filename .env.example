# ==============================================================================
# MindRise Environment Variables Template (DO NOT COMMIT REAL SECRETS)
# ==============================================================================

# Application Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL via Prisma ORM)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mindrise_dev?schema=public

# Authentication & Security
# Generate a strong 256-bit secret for production: `openssl rand -base64 32`
JWT_SECRET=replace_with_secure_random_jwt_secret_min_32_characters
JWT_EXPIRES_IN=1d

# Field-level Encryption Key (for Verified Identity data & clinical assessments)
# 32-byte hex key: `openssl rand -hex 32`
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Supabase Storage (User Avatars & Assets)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=replace_with_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_supabase_service_role_secret
SUPABASE_BUCKET_AVATARS=mindrise-avatars

# SMS Provider Placeholder (e.g., Ethio Telecom SMS Gateway / Twilio / Africa's Talking)
SMS_PROVIDER=ethio_telecom
SMS_API_KEY=placeholder_sms_api_key
SMS_SENDER_ID=MindRise
SMS_API_URL=https://api.sms-provider.example.com/v1/send

# Email Provider Placeholder (SMTP / Resend / SendGrid)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=placeholder_smtp_username
SMTP_PASS=placeholder_smtp_password
EMAIL_FROM=MindRise Support <support@mindrise.et>

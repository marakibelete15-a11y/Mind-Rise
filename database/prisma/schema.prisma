// MindRise Database Schema
// PostgreSQL via Prisma ORM
// SRS Reference: MindRise SRS v1.3
// Privacy by Design: Two-Layer Identity Architecture (Private Verified Identity vs Public Anonymous Profile)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum AccountStatus {
  ACTIVE
  RESTRICTED
  SUSPENDED
  BANNED
}

enum Language {
  EN
  AM
}

enum VerificationChannel {
  SMS
  EMAIL
}

enum AssessmentDomain {
  STRESS
  ANXIETY
  LOW_MOTIVATION
  EMOTIONAL_EXHAUSTION
  LOSS_OF_PURPOSE
}

enum RoutineStatus {
  ACTIVE
  PAUSED
}

enum ReactionType {
  SUPPORT
}

enum ReportTargetType {
  POST
  COMMENT
  ACCOUNT
}

enum ReportStatus {
  PENDING
  REVIEWED
  DISMISSED
  ACTIONED
}

enum CrisisSource {
  ASSESSMENT
  POST
}

enum CrisisPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum CrisisFlagStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum ModerationActionType {
  WARN
  SUSPEND
  BAN
  REMOVE_CONTENT
  REVERSE_RESTRICTION
}

enum AutoRestrictionStatus {
  ACTIVE
  EXPIRED
  REVERSED
}

// =============================================================================
// 1. IDENTITY & PRIVACY LAYER (TWO-LAYER IDENTITY MODEL)
// =============================================================================

/// Core User account entity.
/// Tracks system roles, status, and account lifecycle.
model User {
  id                String        @id @default(uuid()) @db.Uuid
  role              UserRole      @default(USER)
  status            AccountStatus @default(ACTIVE)
  preferredLanguage Language      @default(AM)
  deletedAt         DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // 1:1 Private Verified Identity
  verifiedIdentity VerifiedIdentity?

  // 1:1 Public Anonymous Profile
  profile Profile?

  // Verification & Audit
  verificationCodes          VerificationCode[]
  identityAccessLogsAuthored IdentityAccessLog[] @relation("Accessor")

  // Self-Assessment Module
  assessmentAttempts AssessmentAttempt[]

  // Routines & Gamification
  routines     Routine[]
  userProgress UserProgress?
  userBadges   UserBadge[]

  // Community Activity
  posts            Post[]
  comments         Comment[]
  reactions        Reaction[]
  reportsSubmitted Report[]   @relation("Reporter")

  // Safety & Moderation
  crisisFlags               CrisisFlag[]
  moderationActionsReceived ModerationAction[] @relation("TargetUser")
  moderationActionsAuthored ModerationAction[] @relation("Moderator")
  autoRestrictions          AutoRestriction[]

  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

/// PRIVACY CRITICAL (SRS 5.4, FR-1.1, FR-1.5):
/// Stores contact credentials encrypted at the application layer (AES-256-GCM).
/// To prevent duplicate account abuse (FR-1.5), blind indexes (phoneHash, emailHash)
/// store keyed HMAC-SHA256 hashes of the NORMALIZED value:
/// - Phone numbers normalized to E.164: +251XXXXXXXXX
/// - Email addresses normalized to lowercase and whitespace-trimmed
/// NEVER exposed to peer community or routine moderators.
/// On user account deletion, this record is completely purged (onDelete: Cascade).
model VerifiedIdentity {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @unique @db.Uuid
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName      String
  lastName       String
  phoneEncrypted String?
  emailEncrypted String?
  phoneHash      String?
  emailHash      String?
  verifiedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accessLogs IdentityAccessLog[]

  // Note: CHECK ("phoneEncrypted" IS NOT NULL OR "emailEncrypted" IS NOT NULL)
  // and partial unique indexes for active accounts (FR-1.5) on phoneHash/emailHash
  // are enforced via migration SQL.
  @@index([phoneHash])
  @@index([emailHash])
  @@map("verified_identities")
}

/// Verification OTP codes.
/// Stores code hashes only (never plain text codes).
model VerificationCode {
  id         String              @id @default(uuid()) @db.Uuid
  userId     String              @db.Uuid
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel    VerificationChannel
  codeHash   String
  expiresAt  DateTime
  attempts   Int                 @default(0)
  consumedAt DateTime?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@index([userId, channel])
  @@index([expiresAt])
  @@map("verification_codes")
}

/// PUBLIC IDENTITY (FR-1.3):
/// The only identity exposed on community discussions, leaderboards, and reactions.
model Profile {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @db.Uuid
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  anonymousHandle String   @unique // Case-insensitive unique index added via SQL
  avatarUrl       String?
  bio             String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("profiles")
}

/// AUDIT LOG (SRS 5.4):
/// Logs every access to VerifiedIdentity data for regulatory and privacy compliance.
model IdentityAccessLog {
  id               String           @id @default(uuid()) @db.Uuid
  accessedById     String?          @db.Uuid
  accessedBy       User?            @relation("Accessor", fields: [accessedById], references: [id], onDelete: SetNull)
  targetIdentityId String           @db.Uuid
  targetIdentity   VerifiedIdentity @relation(fields: [targetIdentityId], references: [id], onDelete: Cascade)
  action           String
  reason           String
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime         @default(now())

  @@index([targetIdentityId])
  @@index([accessedById])
  @@map("identity_access_logs")
}

// =============================================================================
// 2. SELF-ASSESSMENT MODULE
// =============================================================================

/// Templates defining domains (Stress, Anxiety, etc.) and risk thresholds.
model AssessmentTemplate {
  id            String           @id @default(uuid()) @db.Uuid
  domain        AssessmentDomain
  titleEn       String
  titleAm       String
  descriptionEn String?
  descriptionAm String?
  version       Int              @default(1)
  riskThreshold Int
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  questions AssessmentQuestion[]
  attempts  AssessmentAttempt[]

  @@unique([domain, version])
  @@map("assessment_templates")
}

/// Individual questions associated with an assessment template.
model AssessmentQuestion {
  id         String             @id @default(uuid()) @db.Uuid
  templateId String             @db.Uuid
  template   AssessmentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  textEn     String
  textAm     String
  order      Int
  isRiskItem Boolean            @default(false)
  scoring    Json
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([templateId, order])
  @@map("assessment_questions")
}

/// User's assessment attempt.
/// PRIVACY REQUIREMENT: Answers JSON must be encrypted at application layer (AES-256-GCM)
/// and visible only to the owning user.
model AssessmentAttempt {
  id          String             @id @default(uuid()) @db.Uuid
  userId      String             @db.Uuid
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateId  String             @db.Uuid
  template    AssessmentTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  answers     Json
  score       Int
  summaryKey  String
  riskFlagged Boolean            @default(false)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  crisisFlags CrisisFlag[]

  @@index([userId, createdAt])
  @@map("assessment_attempts")
}

// =============================================================================
// 3. ROUTINES & GAMIFICATION MODULE
// =============================================================================

/// Individual habit/routine tracked by a user. Supports soft delete.
model Routine {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @db.Uuid
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      RoutineStatus @default(ACTIVE)
  deletedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  completions RoutineCompletion[]

  @@index([userId, status])
  @@map("routines")
}

/// Curated bilingual starter routines suggested to users.
model StarterRoutine {
  id            String   @id @default(uuid()) @db.Uuid
  titleEn       String
  titleAm       String
  descriptionEn String?
  descriptionAm String?
  category      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("starter_routines")
}

/// Completion record for a routine. Unique per routine per calendar day.
model RoutineCompletion {
  id            String   @id @default(uuid()) @db.Uuid
  routineId     String   @db.Uuid
  routine       Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  completedDate DateTime @db.Date
  createdAt     DateTime @default(now())

  @@unique([routineId, completedDate])
  @@index([completedDate])
  @@map("routine_completions")
}

/// Gamified progress metrics (streaks, points).
model UserProgress {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @unique @db.Uuid
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  points            Int       @default(0)
  currentStreak     Int       @default(0)
  longestStreak     Int       @default(0)
  lastCompletedDate DateTime? @db.Date
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("user_progress")
}

/// Available badges in the reward system.
model Badge {
  id            String   @id @default(uuid()) @db.Uuid
  slug          String   @unique
  nameEn        String
  nameAm        String
  descriptionEn String
  descriptionAm String
  iconUrl       String?
  pointsRequired Int     @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userBadges UserBadge[]

  @@map("badges")
}

/// Badges earned by users.
model UserBadge {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId   String   @db.Uuid
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  awardedAt DateTime @default(now())

  @@unique([userId, badgeId])
  @@map("user_badges")
}

// =============================================================================
// 4. COMMUNITY LAYER (ANONYMOUS PEER SUPPORT)
// =============================================================================

/// Topic spaces (e.g. Job Search, University Pressure).
model Topic {
  id            String   @id @default(uuid()) @db.Uuid
  slug          String   @unique
  nameEn        String
  nameAm        String
  descriptionEn String?
  descriptionAm String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  posts Post[]

  @@map("topics")
}

/// Community forum post.
/// On user deletion, authorId becomes null (SetNull) to preserve thread integrity as "deleted user".
model Post {
  id        String    @id @default(uuid()) @db.Uuid
  authorId  String?   @db.Uuid
  author    User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  topicId   String    @db.Uuid
  topic     Topic     @relation(fields: [topicId], references: [id], onDelete: Restrict)
  title     String
  content   String
  isPinned  Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  comments    Comment[]
  reactions   Reaction[]
  crisisFlags CrisisFlag[]

  @@index([topicId, createdAt])
  @@index([authorId])
  @@map("posts")
}

/// Comment on a community post.
/// On user deletion, authorId becomes null (SetNull) to keep thread context.
model Comment {
  id        String    @id @default(uuid()) @db.Uuid
  postId    String    @db.Uuid
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String?   @db.Uuid
  author    User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  content   String
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([postId, createdAt])
  @@index([authorId])
  @@map("comments")
}

/// Peer reaction (e.g. SUPPORT). Unique per user per post.
model Reaction {
  id        String       @id @default(uuid()) @db.Uuid
  postId    String       @db.Uuid
  post      Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String       @db.Uuid
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      ReactionType @default(SUPPORT)
  createdAt DateTime     @default(now())

  @@unique([postId, userId, type])
  @@index([postId])
  @@map("reactions")
}

/// Flagged content or user reports.
/// Reporter ID is strictly preserved for moderation and never exposed to the reported user.
model Report {
  id          String           @id @default(uuid()) @db.Uuid
  reporterId  String?          @db.Uuid
  reporter    User?            @relation("Reporter", fields: [reporterId], references: [id], onDelete: SetNull)
  targetType  ReportTargetType
  targetId    String           @db.Uuid
  reason      String
  status      ReportStatus     @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([targetType, targetId])
  @@index([status])
  @@map("reports")
}

// =============================================================================
// 5. SAFETY & MODERATION LAYER
// =============================================================================

/// Crisis escalation flag generated by assessment risk score or post keyword trigger.
/// onDelete: SetNull preserves safety incident history even if the user deletes their account.
model CrisisFlag {
  id                  String             @id @default(uuid()) @db.Uuid
  userId              String?            @db.Uuid
  user                User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  source              CrisisSource
  sourceId            String?
  assessmentAttemptId String?            @db.Uuid
  assessmentAttempt   AssessmentAttempt? @relation(fields: [assessmentAttemptId], references: [id], onDelete: SetNull)
  postId              String?            @db.Uuid
  post                Post?              @relation(fields: [postId], references: [id], onDelete: SetNull)
  priority            CrisisPriority     @default(HIGH)
  status              CrisisFlagStatus   @default(OPEN)
  userAcknowledgedAt  DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([userId, status])
  @@index([status, priority])
  @@map("crisis_flags")
}

/// Ethiopian crisis hotlines and specialized facilities (e.g. Amanuel Hospital).
model CrisisResource {
  id             String    @id @default(uuid()) @db.Uuid
  nameEn         String
  nameAm         String
  descriptionEn  String
  descriptionAm  String
  phone          String
  isActive       Boolean   @default(true)
  lastVerifiedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("crisis_resources")
}

/// Audit log of actions taken by human moderators.
/// Target user relation uses onDelete: SetNull so moderation history survives account deletion (SRS FR-7.3).
/// targetHandleSnapshot retains the public handle at the time of moderation.
model ModerationAction {
  id                   String               @id @default(uuid()) @db.Uuid
  moderatorId          String?              @db.Uuid
  moderator            User?                @relation("Moderator", fields: [moderatorId], references: [id], onDelete: SetNull)
  targetUserId         String?              @db.Uuid
  targetUser           User?                @relation("TargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  targetHandleSnapshot String?
  type                 ModerationActionType
  reason               String
  createdAt            DateTime             @default(now())

  @@index([targetUserId])
  @@index([moderatorId])
  @@map("moderation_actions")
}

/// Automated safety restrictions triggered by threshold violations (FR-7.5, FR-7.7).
/// Target user relation uses onDelete: SetNull so restriction history survives account deletion.
model AutoRestriction {
  id                     String                @id @default(uuid()) @db.Uuid
  userId                 String?               @db.Uuid
  user                   User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  triggeredByReportCount Int
  windowStart            DateTime
  windowEnd              DateTime
  status                 AutoRestrictionStatus @default(ACTIVE)
  reversedBy             String?
  reversedAt             DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  @@index([userId, status])
  @@map("auto_restrictions")
}
